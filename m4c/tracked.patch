+ * "scenario/m3-android-install.js" -> "spike-capture-m3-android-install.log")
+ * so the m4 and m3 sessions never overwrite each other's second capture. */
+static char *m4_capture_path(const char *context, const char *entry) {
+    const char *slash = strrchr(entry, '/');
+    const char *base = slash ? slash + 1 : entry;
+    const char *dot = strrchr(base, '.');
+    size_t stem = dot ? (size_t)(dot - base) : strlen(base);
+    if (stem > 48) stem = 48;
+    char name[80];
+    snprintf(name, sizeof(name), "spike-capture-%.*s.log", (int)stem, base);
+    return m4_join(context, name);
+}
