{
  "scenario": "session.persistence.midturn",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "llm.producer.bound",
      "match": {
        "face": "llm",
        "provider": "mock"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → loopback chat-completions mock server",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "persistence/booted",
      "match": {
        "leg": "kill"
      }
    },
    {
      "event": "persistence/service",
      "match": {
        "name": "session-persistence-jsonl",
        "key": "sessionPersistence"
      }
    },
    {
      "event": "midturn/armed",
      "match": {
        "sessionId": "s-persist-midturn-0001",
        "prompt": "Say hello slowly"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "midturn/first.delta",
      "match": {
        "delta": "Hello",
        "streamOpen": true
      }
    },
    {
      "event": "midturn/durable",
      "match": {
        "streamOpen": true
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile"
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2"
      }
    },
    {
      "event": "persistence/booted",
      "match": {
        "leg": "resume"
      }
    },
    {
      "event": "persistence/service",
      "match": {
        "name": "session-persistence-jsonl",
        "key": "sessionPersistence"
      }
    },
    {
      "event": "midturn/restored",
      "match": {
        "events": 11,
        "tail": "session/end-seed",
        "closerReason": "interrupted",
        "assistantMessages": 0
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " from"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " upst"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "ream"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "finish": "stop",
        "usage": {
          "inputTokens": 3,
          "outputTokens": 19,
          "totalTokens": 22
        }
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "done": true
      }
    },
    {
      "event": "midturn/continued",
      "match": {
        "restoredEvents": 11,
        "appended": 9,
        "totalEvents": 20,
        "lastTurn": 2
      }
    },
    {
      "event": "midturn/artifact",
      "match": {
        "events": 20
      }
    },
    {
      "event": "upstream/completed",
      "match": {
        "status": "pass",
        "leg": "resume",
        "backend": "vendored session-persistence-jsonl"
      }
    }
  ]
}
