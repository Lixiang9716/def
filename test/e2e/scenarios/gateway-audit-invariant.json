{
  "scenario": "gateway.audit-invariant",
  "extract": {
    "prefix": "dsh.runtime.log:",
    "envelope": "default"
  },
  "expect": [
    { "event": "audit.started", "match": { "leg": "full-matrix" } },
    { "event": "audit.descriptor", "match": { "available": 8, "unavailable": 9 } },
    { "event": "audit.probe", "match": { "cell": "fs.write.ok", "primitive": "fsWrite", "audit": "fsWrite", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "fs.read.ok", "primitive": "fsRead", "audit": "fsRead", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "fs.stat.ok", "primitive": "fsStat", "audit": "fsStat", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "fs.scope.persist.ok", "primitive": "fsScope.persist", "audit": "fsScope.persist", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "fs.scope.resolve.ok", "primitive": "fsScope.resolve", "audit": "fsScope.resolve", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "fs.remove.ok", "primitive": "fsRemove", "audit": "fsRemove", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "keychain.set.ok", "primitive": "keychainSet", "audit": "keychainSet", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "keychain.get.ok", "primitive": "keychainGet", "audit": "keychainGet", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "timer.schedule.ok", "primitive": "timerSchedule", "audit": "timerSchedule", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "timer.cancel.ok", "primitive": "timerCancel", "audit": "timerCancel", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "http.fetch.ok", "primitive": "httpFetch", "audit": "httpFetch", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "wasm.run.io", "primitive": "wasmRun", "audit": "wasmRun", "state": "rejected", "code": "io" } },
    { "event": "audit.probe", "match": { "cell": "http.fetch.invalid", "primitive": "httpFetch", "audit": "httpFetch", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "http.fetch.io", "primitive": "httpFetch", "audit": "httpFetch", "state": "rejected", "code": "io" } },
    { "event": "audit.probe", "match": { "cell": "fs.read.denied", "primitive": "fsRead", "audit": "fsRead", "state": "rejected", "code": "denied" } },
    { "event": "audit.probe", "match": { "cell": "fs.write.invalid", "primitive": "fsWrite", "audit": "fsWrite", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "fs.stat.invalid", "primitive": "fsStat", "audit": "fsStat", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "fs.remove.invalid", "primitive": "fsRemove", "audit": "fsRemove", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "keychain.get.invalid", "primitive": "keychainGet", "audit": "keychainGet", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "keychain.set.invalid", "primitive": "keychainSet", "audit": "keychainSet", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "timer.schedule.invalid", "primitive": "timerSchedule", "audit": "timerSchedule", "state": "rejected", "code": "invalid" } },
    { "event": "audit.probe", "match": { "cell": "socket.listen.ok", "primitive": "socketListen", "audit": "socket.listen", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "socket.connect.ok", "primitive": "socketConnect", "audit": "socket.connect", "state": "ok", "code": null } },
    { "event": "audit.host", "match": { "cell": "socket.accept", "audit": "socket.accept", "hostInitiated": true } },
    { "event": "audit.probe", "match": { "cell": "socket.write.ok", "primitive": "socketWrite", "audit": "socket.write", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "socket.end.ok", "primitive": "socketEnd", "audit": "socket.end", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "socket.close.conn.ok", "primitive": "socketClose", "audit": "socket.close", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "socket.close.server.ok", "primitive": "socketClose", "audit": "socket.close", "state": "ok", "code": null } },
    { "event": "audit.probe", "match": { "cell": "socket.listen.denied", "primitive": "socketListen", "audit": "socket.listen", "state": "rejected", "code": "denied" } },
    { "event": "audit.probe", "match": { "cell": "socket.connect.denied", "primitive": "socketConnect", "audit": "socket.connect", "state": "rejected", "code": "denied" } },
    { "event": "audit.probe", "match": { "cell": "unavailable.fs.list", "primitive": "fsList", "audit": "fsList", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.fs.mkdir", "primitive": "fsMkdir", "audit": "fsMkdir", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.fs.rename", "primitive": "fsRename", "audit": "fsRename", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.ish.run", "primitive": "ishRun", "audit": "ishRun", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.notify", "primitive": "notify", "audit": "notify", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.present.approval", "primitive": "presentApproval", "audit": "presentApproval", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.present.picker", "primitive": "presentPicker", "audit": "presentPicker", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.device.info", "primitive": "deviceInfo", "audit": "deviceInfo", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.haptic", "primitive": "haptic", "audit": "haptic", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.clipboard.read", "primitive": "clipboardRead", "audit": "clipboardRead", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.clipboard.write", "primitive": "clipboardWrite", "audit": "clipboardWrite", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.present.share", "primitive": "presentShare", "audit": "presentShare", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.keep.awake", "primitive": "keepAwake", "audit": "keepAwake", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.channel.open", "primitive": "channelOpen", "audit": "channelOpen", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.channel.close", "primitive": "channelClose", "audit": "channelClose", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.present.surface", "primitive": "presentSurface", "audit": "presentSurface", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.surface.draw", "primitive": "surfaceDraw", "audit": "surfaceDraw", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "unavailable.close.surface", "primitive": "closeSurface", "audit": "closeSurface", "state": "unavailable", "code": null } },
    { "event": "audit.probe", "match": { "cell": "http.abort", "primitive": "httpFetch.abort", "audit": "httpFetch.abort", "state": "accepted", "code": null } },
    { "event": "audit.passed", "match": { "calls": 48 } },
    { "event": "scenario.complete", "match": { "status": "pass" } }
  ]
}
