{
  "scenario": "llm.piai-probe",
  "extract": { "prefix": "dsh.runtime.log:" },
  "expect": [
    { "event": "llm/runtime", "match": {
      "provider": "mock",
      "model": "mock-1",
      "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
      "transport": "gateway httpFetch → loopback chat-completions mock server",
      "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
    } },
    { "event": "upstream/profile", "match": {
      "profile": "mobile",
      "root": "empty (patch layers compose over it)",
      "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
      "layers": ["session", "agent", "system-prompt", "tools", "session-projection", "settings", "agent-loop"]
    } },
    { "event": "llm/piai", "match": {
      "plugin": "@deepseek-ai/dsh-llm-pi-ai",
      "routes": ["piai-test"],
      "protocols": ["openai-completions"]
    } },
    { "event": "upstream/services", "match": {
      "kernel": "@deepseek-ai/cordis@4.0.2",
      "services": ["sessions", "agents", "systemPrompt", "tools", "sessionProjections", "settings", "agentLoop", "llm"],
      "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
    } },
    { "event": "probe/piai-mounted", "match": { "routes": ["piai-test"] } },
    { "event": "probe/list-providers", "match": {
      "routes": ["mock", "piai-test"],
      "piaiName": "pi-ai test route"
    } },
    { "event": "probe/list-models", "match": {
      "provider": "piai-test",
      "models": ["piai-mock-1"]
    } },
    { "event": "probe/resolve-model", "match": {
      "provider": "piai-test",
      "id": "piai-mock-1",
      "name": "pi-ai mock model",
      "contextWindow": 8192
    } },
    { "event": "probe/prepare-call", "match": {
      "provider": "piai-test",
      "model": "piai-mock-1",
      "retryPolicyMode": "normal",
      "dispatched": true
    } },
    { "event": "probe/wire", "match": {
      "path": "/v1/chat/completions",
      "model": "piai-mock-1",
      "stream": true,
      "bearer": true
    } },
    { "event": "probe/stream", "match": {
      "kinds": "block-start,text-delta,text-delta,text-delta,block-end,usage,finish",
      "text": "Hello from pi-ai",
      "finish": "stop",
      "inputTokens": 11,
      "outputTokens": 4,
      "totalTokens": 15
    } },
    { "event": "probe/completed", "match": {
      "status": "pass",
      "adapter": "vendored dsh-llm-pi-ai PiAiAdapter"
    } }
  ]
}
