{
  "scenario": "mcp.plugin",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "mcp/plugin.begin",
      "match": {}
    },
    {
      "event": "mcp/credential.stored",
      "match": {
        "ref": "mcp/demo/credential",
        "bytes": 20
      }
    },
    {
      "event": "llm.producer.bound",
      "match": {
        "face": "llm",
        "provider": "mock"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → loopback chat-completions mock server",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "mcp/plugin.spine-booted",
      "match": {
        "sessionId": "s-mcp-plugin-0001"
      }
    },
    {
      "event": "mcp/tools.registered",
      "match": {
        "count": 2,
        "names": [
          "mcp_demo_echo",
          "mcp_demo_add"
        ]
      }
    },
    {
      "event": "mcp/call.echo",
      "match": {
        "tool": "mcp_demo_echo",
        "text": "hello from the dsh-mcp plugin"
      }
    },
    {
      "event": "mcp/call.add",
      "match": {
        "tool": "mcp_demo_add",
        "text": "42"
      }
    },
    {
      "event": "mcp/call.local-refused",
      "match": {
        "tool": "mcp_demo_add",
        "code": "INVALID_ARGS"
      }
    },
    {
      "event": "mcp/call.server-error",
      "match": {
        "tool": "mcp_demo_add",
        "forwarded": true
      }
    },
    {
      "event": "mcp/plugin.completed",
      "match": {
        "status": "pass"
      }
    }
  ]
}
