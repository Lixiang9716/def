{
  "scenario": "mcp.streamable-http",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "llm.producer.bound",
      "match": {
        "face": "llm",
        "provider": "mock"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → loopback chat-completions mock server",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "mcp/transport-created",
      "match": {
        "kind": "streamable-http",
        "wire": "gateway.httpFetch"
      }
    },
    {
      "event": "mcp/wire",
      "match": {
        "method": "POST",
        "status": 200,
        "contentType": "application/json",
        "rpcMethod": "initialize"
      }
    },
    {
      "event": "mcp/wire",
      "match": {
        "method": "POST",
        "status": 202,
        "rpcMethod": "notifications/initialized"
      }
    },
    {
      "event": "mcp/wire",
      "order": "any",
      "match": {
        "method": "GET",
        "status": 405,
        "contentType": "application/json"
      }
    },
    {
      "event": "mcp/connected",
      "match": {
        "serverName": "dsh-mock-mcp",
        "serverVersion": "0.0.1",
        "sessionId": "sess-mock-0001"
      }
    },
    {
      "event": "mcp/wire",
      "match": {
        "method": "POST",
        "status": 200,
        "contentType": "text/event-stream",
        "rpcMethod": "tools/list"
      }
    },
    {
      "event": "mcp/tools-listed",
      "match": {
        "count": 2,
        "names": [
          "add",
          "echo"
        ]
      }
    },
    {
      "event": "mcp/wire",
      "match": {
        "method": "POST",
        "status": 200,
        "contentType": "application/json",
        "rpcMethod": "tools/call"
      }
    },
    {
      "event": "mcp/tool-called",
      "match": {
        "tool": "echo",
        "text": "hello from dsh-mobile"
      }
    },
    {
      "event": "mcp/wire",
      "match": {
        "method": "POST",
        "status": 200,
        "contentType": "application/json",
        "rpcMethod": "tools/call"
      }
    },
    {
      "event": "mcp/tool-called",
      "match": {
        "tool": "add",
        "text": "42"
      }
    },
    {
      "event": "mcp/closed",
      "match": {}
    },
    {
      "event": "probe/completed",
      "match": {
        "status": "pass"
      }
    }
  ]
}
