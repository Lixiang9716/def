{
  "scenario": "llm.chaos.oversized",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "llm.producer.bound",
      "match": {
        "face": "llm",
        "provider": "mock"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → loopback chat-completions mock server",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "session/created",
      "match": {
        "sessionId": "s-llm-chaos-0001"
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-llm-chaos-0001"
      }
    },
    {
      "event": "chaos/profile",
      "match": {
        "profile": "oversized",
        "source": "ci/mock-llm-server.mjs DSH_MOCK_CHAOS preset (vendored dsh-llm-mock-server behaviors)"
      }
    },
    {
      "event": "llm/request/built",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "messages": 2,
        "tools": 20,
        "path": "/chat/completions",
        "method": "POST",
        "agentLoopMarked": true,
        "stream": true,
        "attempt": 1
      }
    },
    {
      "comment": "the oversized wire: ONE SSE frame whose delta carries all 2097152 chars — the parse evidence pins length+head, never the text",
      "event": "llm/sse",
      "match": {
        "deltaLength": 2097152,
        "deltaHead": "xxxxxxxx"
      }
    },
    {
      "comment": "the terminal chunk and the [DONE] sentinel still arrive behind the giant frame",
      "event": "llm/sse",
      "match": {
        "finish": "stop",
        "usage": {
          "inputTokens": 3,
          "outputTokens": 2097152,
          "totalTokens": 2097155
        }
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "done": true
      }
    },
    {
      "event": "agent/inbox/spliced",
      "match": {
        "seq": 0
      }
    },
    {
      "event": "turn/start",
      "match": {
        "turn": 1
      }
    },
    {
      "event": "agent/inbox/spliced",
      "match": {
        "seq": 2
      }
    },
    {
      "event": "step/start",
      "match": {
        "turn": 1,
        "step": 1
      }
    },
    {
      "event": "system/message",
      "match": {
        "seq": 4,
        "plugin": "@deepseek-ai/dsh-system-prompt"
      }
    },
    {
      "event": "user/message",
      "match": {
        "seq": 5
      }
    },
    {
      "event": "request/header",
      "match": {
        "seq": 6,
        "reason": "initial"
      }
    },
    {
      "event": "request/context",
      "match": {
        "seq": 7,
        "provider": "mock",
        "model": "mock-1"
      }
    },
    {
      "comment": "the durable assistant message carries the FULL hostile-sized text (length-pinned)",
      "event": "assistant/message",
      "match": {
        "seq": 8,
        "blocks": [
          "text"
        ],
        "textLength": 2097152,
        "textHead": "xxxxxxxx",
        "provider": "mock",
        "model": "mock-1"
      }
    },
    {
      "event": "step/end",
      "match": {
        "turn": 1,
        "step": 1
      }
    },
    {
      "event": "turn/end",
      "match": {
        "turn": 1,
        "reason": "completed",
        "errorCode": null,
        "cancelKind": null
      }
    },
    {
      "event": "session/log/asserted",
      "match": {
        "count": 11,
        "types": [
          "agent/inbox/spliced",
          "turn/start",
          "agent/inbox/spliced",
          "step/start",
          "system/message",
          "user/message",
          "request/header",
          "request/context",
          "assistant/message",
          "step/end",
          "turn/end"
        ]
      }
    },
    {
      "event": "chaos/oversized/asserted",
      "match": {
        "textLength": 2097152,
        "wireRequests": 1
      }
    },
    {
      "event": "agent/status",
      "match": {
        "status": "running"
      }
    },
    {
      "event": "agent/status",
      "match": {
        "status": "idle"
      }
    },
    {
      "event": "projection/turn-boundary",
      "match": {
        "lastTurn": 1
      }
    },
    {
      "event": "chaos/completed",
      "match": {
        "status": "pass",
        "profile": "oversized",
        "guards": "byte-bridge survival (2 MiB single delta completes)",
        "upstream": "0.1.6-alpha.2"
      }
    }
  ]
}
