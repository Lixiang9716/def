{
  "scenario": "android.session-persist.midturn",
  "extract": {
    "prefix": "dsh.runtime.log:"
  },
  "expect": [
    {
      "event": "client.selected",
      "match": {
        "client": "dsh-web-official",
        "source": "launch"
      }
    },
    {
      "event": "llm.producer.bound",
      "match": {
        "face": "llm",
        "provider": "mock"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "service": "vendored @deepseek-ai/dsh-llm LlmRuntime (adapter registry)",
        "transport": "gateway httpFetch → carrier scripted chat-completions (E2E determinism boundary, mirrors the CLI mock server)",
        "userAgent": "deepseek-harness/0.1.6-alpha.2 (+https://github.com/deepseek-ai/deepseek-harness)"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile",
        "root": "empty (patch layers compose over it)",
        "upstream": "0.1.6-alpha.2 (vendored verbatim, sha256-pinned)",
        "layers": [
          "session",
          "agent",
          "system-prompt",
          "tools",
          "session-projection",
          "settings",
          "agent-loop"
        ]
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2",
        "services": [
          "sessions",
          "agents",
          "systemPrompt",
          "tools",
          "sessionProjections",
          "settings",
          "agentLoop",
          "llm"
        ],
        "llm": "vendored LlmRuntime + gateway adapter (provider \"mock\")"
      }
    },
    {
      "event": "persistence/service",
      "match": {
        "name": "session-persistence-jsonl",
        "key": "sessionPersistence"
      }
    },
    {
      "event": "restart/seed",
      "match": {
        "sessionId": "s-android-persist-midturn-0001",
        "restoredEvents": 0
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-android-persist-midturn-0001"
      }
    },
    {
      "event": "restart/stage",
      "match": {
        "stage": "create",
        "sessionId": "s-android-persist-midturn-0001"
      }
    },
    {
      "event": "midturn/armed",
      "match": {
        "sessionId": "s-android-persist-midturn-0001",
        "prompt": "SLOW_TURN Say hello slowly"
      }
    },
    {
      "event": "llm/request/built",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "messages": 2,
        "path": "/chat/completions",
        "method": "POST",
        "agentLoopMarked": true,
        "stream": true
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "midturn/first.delta",
      "match": {
        "delta": "Hello",
        "streamOpen": true
      }
    },
    {
      "event": "midturn/durable",
      "match": {
        "streamOpen": true
      }
    },
    {
      "event": "llm/sse",
      "repeat": true
    },
    {
      "event": "client.selected",
      "match": {
        "client": "dsh-web-official",
        "source": "launch"
      }
    },
    {
      "event": "llm/runtime",
      "match": {
        "provider": "mock",
        "model": "mock-1"
      }
    },
    {
      "event": "upstream/profile",
      "match": {
        "profile": "mobile"
      }
    },
    {
      "event": "upstream/services",
      "match": {
        "kernel": "@deepseek-ai/cordis@4.0.2"
      }
    },
    {
      "event": "persistence/service",
      "match": {
        "name": "session-persistence-jsonl",
        "key": "sessionPersistence"
      }
    },
    {
      "event": "restart/seed",
      "match": {
        "sessionId": "s-android-persist-midturn-0001",
        "restoredEvents": 11
      }
    },
    {
      "event": "agent/created",
      "match": {
        "id": "main",
        "sessionId": "s-android-persist-midturn-0001"
      }
    },
    {
      "event": "restart/stage",
      "match": {
        "stage": "resume",
        "sessionId": "s-android-persist-midturn-0001"
      }
    },
    {
      "event": "midturn/restored",
      "match": {
        "events": 11,
        "tail": "session/end-seed",
        "closerReason": "interrupted",
        "assistantMessages": 0
      }
    },
    {
      "event": "llm/request/built",
      "match": {
        "provider": "mock",
        "model": "mock-1",
        "path": "/chat/completions",
        "method": "POST",
        "agentLoopMarked": true,
        "stream": true
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "Hello"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " from"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": " upst"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "delta": "ream"
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "finish": "stop",
        "usage": {
          "inputTokens": 3,
          "outputTokens": 19,
          "totalTokens": 22
        }
      }
    },
    {
      "event": "llm/sse",
      "match": {
        "done": true
      }
    },
    {
      "event": "midturn/continued",
      "match": {
        "restoredEvents": 11,
        "appended": 9,
        "totalEvents": 20,
        "lastTurn": 2
      }
    },
    {
      "event": "midturn/artifact",
      "match": {
        "sessionId": "s-android-persist-midturn-0001",
        "events": 20
      }
    },
    {
      "event": "restart/leg.settled",
      "match": {
        "leg": "resume",
        "pass": true,
        "restoredEvents": 11,
        "totalEvents": 20,
        "lastTurn": 2
      }
    },
    {
      "event": "upstream/completed",
      "match": {
        "status": "pass",
        "leg": "resume",
        "backend": "vendored session-persistence-jsonl"
      }
    }
  ]
}
