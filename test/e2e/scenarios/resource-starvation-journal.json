{
  "scenario": "resource.starvation",
  "extract": { "prefix": "dsh.runtime.log:" },
  "expect": [
    { "event": "journal.starve.begin", "match": { "leg": "grow" } },
    { "event": "journal.starve.growth", "match": { "leg": "grow" }, "repeat": true },
    { "event": "journal.starve.named", "match": { "leg": "grow" } },
    { "event": "journal.starve.verdict", "match": { "leg": "grow", "status": "pass" } }
  ]
}
