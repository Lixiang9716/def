 /* JS → host abort: no promise of its own — the embedder matches the
- * in-flight call (by the callId inside args_json) and cancels it. */
+ * in-flight call (by the callId inside args_json) and cancels it. The
+ * frozen shim passes the response's bodyId string ("body:<callId>"); a
+ * bare number is accepted too (the iOS bridge documents the same
+ * tolerance). "body:<n>" through JS_ToInt32 would coerce to 0 and lose
+ * the target, so the string form parses explicitly. */
+static int abort_target(JSContext *ctx, JSValueConst val, int32_t *out) {
+    if (JS_IsString(val)) {
+        const char *text = JS_ToCString(ctx, val);
+        if (!text) return 0;
+        int ok = strncmp(text, "body:", 5) == 0 && text[5] != 0;
+        if (ok) {
+            char *end = NULL;
+            long n = strtol(text + 5, &end, 10);
+            ok = end != NULL && *end == 0 && n > 0 && n <= 0x7fffffffL;
+            if (ok) *out = (int32_t)n;
+        }
+        JS_FreeCString(ctx, text);
+        return ok;
+    }
+    return JS_ToInt32(ctx, out, val) == 0 && *out > 0;
+}
