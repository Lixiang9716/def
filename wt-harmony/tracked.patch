+++ b/.github/workflows/dev-harmonyos.yml
@@ -50,9 +50,13 @@ jobs:
     steps:
       - uses: actions/checkout@v4
 
+      # Node here is runner hygiene, not a build input: ohpm and hvigorw run
+      # under the node the CLT ships (bin/ohpm and bin/hvigorw default
+      # DEVECO_NODE_HOME to clt/tool/node and prepend it to PATH; the CLT's own
+      # node is v24). Version 22 matches the other pipelines.
       - uses: actions/setup-node@v4
         with:
-          node-version: '20'
+          node-version: '22'
 
       - name: Cache the unpacked HarmonyOS CLT
         # Cache hit: the unpacked tree is restored and every install step is
@@ -97,6 +101,31 @@ jobs:
             exit 1
           fi
 
+      - name: Cache the vendored quickjs-ng tree
+        # ensure.sh re-fetches the pinned engine tarball on every run
+        # otherwise; restoring the tree turns that into a presence check (the
+        # script is idempotent — files present means exit 0, nothing fetched).
+        #
+        # The key hashes ensure.sh, and that script IS the tracked pin record
+        # (the commit sha + tarball sha256 live in it), so a pin change hashes
+        # differently and the tree is refetched. Deliberately no
+        # restore-keys: a fallback match would restore a PREVIOUS pin's tree,
+        # and ensure.sh decides presence by file existence rather than by
+        # re-hashing, so a stale tree would be accepted rather than rejected.
+        #
+        # The key is also deliberately NOT the closure key the workflows that
+        # run ensure-dsh.sh as well use (vendor-closure-…): a GitHub cache key
+        # is written once and never refreshed, so one shared key would freeze
+        # the entry at the subtree set of whichever workflow saved first — and
+        # this one carries quickjs-ng only.
+        #
+        # Single-line key expression on purpose: a folded multi-line scalar can
+        # resolve to a literal, giving a cache that never hits.
+        uses: actions/cache@v4
+        with:
+          path: runtime/spike/vendor/quickjs-ng
+          key: vendor-quickjs-ng-${{ hashFiles('runtime/spike/vendor/ensure.sh') }}
+
       - name: Materialize the pinned quickjs-ng vendor tree
         # Untracked by design (upstream discipline D6); ensure.sh fetches and
         # sha256-verifies it. The project's CMake also runs it before
