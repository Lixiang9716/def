@@ -169,6 +174,34 @@ jobs:
             presentation/official-web/dist
             presentation/official-web/client-bundles/npm
           key: official-web-${{ hashFiles('presentation/official-web/MANIFEST.sha256', 'presentation/official-web/build-upstream.sh', 'presentation/official-web/client-bundles/MANIFEST.sha256', 'presentation/official-web/client-bundles/build-client-bundles.sh', 'presentation/official-web/client-bundles/ROSTER.json', 'tools/e2e/ensure-official-dist.sh', 'tools/e2e/ensure-client-bundles.sh') }}
+      - name: Cache the vendored closure (quickjs-ng + the pinned DSH runtime)
+        # The closure is consumed twice over in this job: quickjs-ng by the
+        # Gradle build's own ensureSpikeVendor task (ensure.sh, wired ahead of
+        # the CMake project) and the DSH/npm trees by stage-spine-closure.sh,
+        # which byte-compares the staged assets against them. Both ensure
+        # scripts fetch their pinned tarballs on every run otherwise — 27
+        # sha256-verified downloads whose pins do not change between runs.
+        # Restoring turns that into a presence check: the scripts are
+        # idempotent (files present means exit 0, nothing fetched).
+        #
+        # The key hashes THE TWO SCRIPTS, because those scripts ARE the tracked
+        # pin record (the quickjs-ng commit + tarball sha256 in ensure.sh, the
+        # per-package sha256 table in ensure-dsh.sh); any pin change hashes
+        # differently and refetches. Deliberately no restore-keys: a fallback
+        # match would restore a PREVIOUS pin's tree, and the scripts decide
+        # presence by file existence rather than by re-hashing, so a stale tree
+        # would be accepted rather than rejected.
+        #
+        # Single-line key expression on purpose: a folded multi-line scalar can
+        # resolve to a literal, giving a cache that never hits.
+        uses: actions/cache@v4
+        with:
+          path: |
+            runtime/spike/vendor/quickjs-ng
+            runtime/spike/vendor/dsh
+            runtime/spike/vendor/npm
+          key: vendor-closure-${{ hashFiles('runtime/spike/vendor/ensure.sh', 'runtime/spike/vendor/ensure-dsh.sh') }}
+
       - name: Materialize the vendored web app + DSH closure
         env:
           COREPACK_INTEGRITY_KEYS: '0'
